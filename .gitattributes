# Consistent line endings matter more than usual here: a stray CR in a .sh file is
# "bash\r: No such file or directory" inside a Linux container, and a CRLF
# Dockerfile breaks a heredoc. Store LF, and never let git touch real binaries.
* text=auto eol=lf

*.sh        text eol=lf
Makefile    text eol=lf
*.py        text eol=lf
*.sql       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.toml      text eol=lf
*.groovy    text eol=lf
*.conf      text eol=lf
.env.example  text eol=lf

*.jar          binary
*.png          binary
*.jpg          binary
*.parquet      binary
*.avro         binary
*.gz           binary
*.zip          binary
*.joblib       binary
*.pt           binary
*.onnx         binary

# GitHub linguist: keep the docs/language stats honest
docs/** linguist-documentation
*.groovy linguist-language=Groovy
