# =============================================================================
# .env.example — copy to `.env` and edit.  `scripts/bootstrap` does it for you.
# docker compose automatically reads `.env` at the project root.
# NOTHING secret goes into git; `.env` is in .gitignore.
# =============================================================================

# ---------- how much RAM your laptop can spare ----------
SPARK_WORKER_MEMORY=2g
SPARK_WORKER_CORES=2

# ---------- ports on your laptop (change if something is already using them) ----------
SPARK_UI_PORT=8080
SPARK_MASTER_PORT=7077
SPARK_JOB_UI_PORT=4040
KAFKA_INTERNAL_PORT=9092
KAFKA_HOST_PORT=9094
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
POSTGRES_PORT=5432
REDIS_PORT=6379
AIRFLOW_PORT=8085
NIFI_PORT=8090
API_PORT=8000
MLFLOW_PORT=5000
CDC_PG_PORT=5433
CDC_CONNECT_PORT=8083

# ---------- object storage (MinIO = self-hosted S3) ----------
S3_BUCKET=lakehouse
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# ---------- postgres ----------
POSTGRES_USER=haweye
POSTGRES_PASSWORD=haweye
POSTGRES_DB=lakehouse
LAKEHOUSE_DB_PASSWORD=lakehouse_app
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# ---------- CDC / Debezium (docker-compose.cdc.yml) ----------
CDC_ENABLED=false
# admin login for the CDC database (the demo's "source of truth")
CDC_PG_USER=cdc
CDC_PG_PASSWORD=cdc
# NOTE: the Debezium connector does NOT use this login. It uses the separate
# REPLICATION role `debezium` created by cdc/sql/00_cdc_setup.sql, because a
# replication client should not own the tables it reads.
CDC_PUBLICATION=haweye_cdc
CDC_SLOT_NAME=haweye_cdc_slot
CDC_KAFKA_SERVERS=kafka-connect-kafka:29092

# ---------- data generator (the fake acquirer feed) ----------
GEN_RATE_PER_SEC=25
GEN_FRAUD_RATE=0.05
GEN_HOURS=0
GEN_SEED=20240601
# Anything else you want passed to generator.py, e.g.:
#   GEN_EXTRA_ARGS=--synthetic --count 5000 --card CARD-00042
# (`--help` inside the container lists the rest:
#   docker compose run --rm --entrypoint bash generator -c "python generator.py --help")

# ---------- model / alerts ----------
FRAUD_MODEL_URI=s3a://lakehouse/models/fraud_rf
FRAUD_SCORE_THRESHOLD=0.6

# ---------- optional MLflow (start with: docker compose --profile mlflow up -d) ----------
MLFLOW_TRACKING_URI=

# ---------- pinned image + jar versions (only touch if you know why) ----------
CONFLUENT_VERSION=7.6.1
MINIO_VERSION=RELEASE.2024-06-13T22-53-53Z
MC_VERSION=RELEASE.2024-06-12T14-34-03Z
POSTGRES_VERSION=16.3
REDIS_VERSION=7.2.4-alpine
SPARK_VERSION=3.5.1
PYTHON_VERSION=3.11
AIRFLOW_VERSION=2.8.0
NIFI_VERSION=1.27.0
MLFLOW_VERSION=v2.14.1
ICEBERG_VERSION=1.5.2
HADOOP_AWS_VERSION=3.3.4
AWS_SDK_VERSION=2.25.6
POSTGRES_JDBC_VERSION=42.7.3
DEBEZIUM_VERSION=2.6.1.Final
STRIMZI_KAFKA_VERSION=3.6.0
