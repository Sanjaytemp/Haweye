# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Spark / JVM build noise (generated inside mounted volumes at runtime)
# ---------------------------------------------------------------------------
.spark-jars/
.spark-cache/
metastore_db/
spark-warehouse/
derby.log
*.jar
!infra/docker/spark/*.jar

# ---------------------------------------------------------------------------
# Local runtime state (never commit data or credentials)
# ---------------------------------------------------------------------------
.env
.env.local
data/
logs/
tmp/
# artifacts/ is NOT ignored here on purpose: docker-compose bind-mounts it into the
# spark + airflow + serving-api containers, so the directory has to exist in a fresh
# clone (otherwise Docker creates it as root-owned and the first model publish fails
# on a permission error).  Its contents are ignored by artifacts/.gitignore instead.
models/local/
.run/
.spark-jars/
*.pid
.kube/
.pytest_cache/
.coverage
htmlcov/
nifi/flow/*.db
*.lock

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
